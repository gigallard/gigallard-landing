---
const reasons = [
  {
    icon: "🤝",
    title: "Para cualquier actividad",
    description: "Médicos, abogados, productores agropecuarios, dueños de comercios y fábricas familiares. Si tenés una actividad con tareas repetitivas, podemos ayudarte — sin importar el rubro."
  },
  {
    icon: "⚡",
    title: "Sin necesidad de saber de tecnología",
    description: "Nos encargamos de todo lo técnico. Vos nos contás cómo trabajás hoy y nosotros encontramos cómo hacerlo más fácil, rápido y eficiente con las herramientas correctas."
  },
  {
    icon: "📈",
    title: "Resultados concretos y medibles",
    description: "Nada de proyectos eternos ni promesas vacías. En pocas semanas ya tenés mejoras visibles: menos tiempo en tareas manuales, menos errores, más tiempo para lo que realmente importa."
  }
];
---
<section class="py-24 px-6 bg-gradient-to-b from-[#050a14] to-black">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">¿Por qué Gigallard?</h2>
      <p class="text-gray-400 text-lg max-w-xl mx-auto">Trabajamos distinto. Y nuestros clientes lo notan desde el primer día.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reasons.map((r) => (
        <div class="text-center">
          <div class="text-4xl mb-4">{r.icon}</div>
          <h3 class="text-white font-semibold text-xl mb-3">{r.title}</h3>
          <p class="text-gray-400 leading-relaxed">{r.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
